# Nunca use prefixo VITE_ para segredos. Copie para .env apenas localmente.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
# Use a conexão direta do Neon para migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
AUTH_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
APP_ORIGIN=http://localhost:5173
TENANT_ID=doce-afeto
PORT=3001
NODE_ENV=development
# O checkout de retirada funciona sem gateway.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_SANDBOX=true
# URL pública HTTPS da API (após deploy)
API_PUBLIC_URL=
# Necessários para habilitar pedidos reais; no demo são informativos.
SHOP_NAME=Doce Afeto
SHOP_PICKUP_ADDRESS=
SHOP_PICKUP_HOURS=
